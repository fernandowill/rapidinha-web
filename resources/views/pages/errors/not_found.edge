@layouts.marketing({ title: 'Página não encontrada' })
  <div class="home">
    <article class="prose-card">
      <div class="pc-top">
        <span class="pc-status mono tag" style="color: var(--subtle);">
          <span class="dot"></span>
          404
        </span>
      </div>
      <div class="pc-lead"><span>Página não encontrada.</span> <em>Esse endereço não existe.</em></div>
      <p class="pc-para">
        Confira o endereço ou volte para os vídeos.
      </p>
      @link({ route: 'home', class: 'btn btn--primary' })
        Ver vídeos
      @end
    </article>
  </div>
@end
