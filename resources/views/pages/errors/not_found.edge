@layouts.marketing()
  <div class="home">
    <article class="prose-card">
      <div class="pc-top">
        <span class="pc-status mono tag" style="color: var(--subtle);">
          <span class="dot"></span>
          404
        </span>
      </div>
      <div class="pc-lead"><span>Página não encontrada.</span> <em>Esse endereço não existe.</em></div>
      <p class="pc-para">
        Confira o endereço ou volte para os videos.
      </p>
      <a href="/">Clique aqui para retornar</a>
    </article>
  </div>
@end
