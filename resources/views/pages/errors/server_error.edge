@layouts.marketing({ title: 'Erro no servidor' })
  <div class="home">
    <article class="prose-card">
      <div class="pc-top">
        <span class="pc-status mono tag" style="color: #c0392b;">
          <span class="dot"></span>
          {{ error.status || 500 }}
        </span>
      </div>
      <div class="pc-lead">
        <span>Algo deu errado.</span>
        <em>O servidor encontrou um erro inesperado.</em>
      </div>
      <p class="pc-para">
        Tente de novo em instantes. Se o problema continuar, avise a gente.
      </p>
      @link({ route: 'home', class: 'btn btn--primary' })
        Ver vídeos
      @end
    </article>
  </div>
@end
