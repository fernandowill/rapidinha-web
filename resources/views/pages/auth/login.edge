@layouts.auth({ title: 'Entrar' })
  <h1 class="auth__title">Bem-vindo de volta</h1>
  <p class="auth__sub">Entre para assistir e publicar vídeos.</p>
  @form({
    route: 'session.store',
    method: 'POST',
    class: 'auth__form',
    'x-data': '{ submitting: false }',
    'x-on:submit': 'submitting = true',
  })
    @field.root({ name: 'email' })
      @!field.label({ text: 'E-mail' })
      @!input.control({
        type: 'email',
        autocomplete: 'username',
        placeholder: 'voce@exemplo.com',
      })
      @!field.error()
    @end
    @field.root({ name: 'password' })
      @!field.label({ text: 'Senha' })
      @!input.control({
        type: 'password',
        autocomplete: 'current-password',
        placeholder: '••••••••',
      })
      @!field.error()
    @end
    @!button({
      text: 'Entrar',
      type: 'submit',
      block: true,
      style: 'margin-top: 4px;',
      'x-bind:disabled': 'submitting',
      'x-text': "submitting ? 'Entrando…' : 'Entrar'",
    })
  @end

  <p class="auth__foot">
    Ainda não tem conta?
    @link({ route: 'new_account.create', class: 'il' })
      Criar conta
    @end
  </p>
@end
