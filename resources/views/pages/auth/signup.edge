@layouts.auth()
  <h1 class="auth__title">Crie sua conta</h1>
  @form({
    route: 'new_account.store',
    method: 'POST',
    class: 'auth__form',
    'x-data': '{ submitting: false }',
    'x-on:submit': 'submitting = true',
  })
    @field.root({ name: 'fullName' })
      @!field.label({ text: 'Nome completo' })
      @!input.control({ autocomplete: 'name', placeholder: 'Fulaninho de tal' })
      @!field.error()
    @end
    @field.root({ name: 'username' })
      @!field.label({ text: 'Nome de usuário' })
      @!input.control({ autocomplete: 'username', placeholder: 'Joe_Goldberg' })
      @!field.error()
    @end
    @field.root({ name: 'email' })
      @!field.label({ text: 'Email' })
      @!input.control({
        type: 'email',
        autocomplete: 'email',
        placeholder: 'you@example.com',
      })
      @!field.error()
    @end
    @field.root({ name: 'password' })
      @!field.label({ text: 'Senha' })
      @!input.control({
        type: 'password',
        autocomplete: 'new-password',
        placeholder: '••••••••',
      })
      @!field.error()
    @end
    @field.root({ name: 'passwordConfirmation' })
      @!field.label({ text: 'Confirmação de Senha' })
      @!input.control({
        type: 'password',
        autocomplete: 'new-password',
        placeholder: '••••••••',
      })
      @!field.error()
    @end
    @!button({
      text: 'Criar conta',
      type: 'submit',
      block: true,
      style: 'margin-top: 4px;',
      'x-bind:disabled': 'submitting',
      'x-text': "submitting ? 'One moment…' : 'Create account'",
    })
  @end

  <p class="auth__foot">
    
    Já tem uma conta?

    @link({ route: 'session.create', class: 'il' })
      Fazer Login
    @end
  </p>
@end
