@layouts.app({ title: 'Vídeos' })
  @page({
    title: q ? `Resultados para "${q}"` : 'Vídeos',
    description: q ? `${videos.length} vídeo(s) encontrado(s)` : 'Seus videos postados',
  })
    @form({ action: '/videos/created', method: 'GET', class: 'video-search' })
      @field.root({ name: 'q' })
        @!input.control({ type: 'search', placeholder: 'Buscar por título…', value: q })
      @end
      <button type="submit" class="btn btn--primary">
        @svg('lucide:search', { width: 15, height: 15 })
        Buscar
      </button>
    @end

    <div class="video-grid">
      @each(video in videos)
        <a href="{{ route('video_show', { publicId: video.publicId }) }}" class="video-card">
          <img src="{{ video.thumbnailPath }}" alt="{{ video.title }}" class="video-card__thumb" loading="lazy" />
          <span class="video-card__title">{{ video.title }}</span>
        </a>
      @else
        <p class="video-grid__empty">
          {{ q ? 'Nenhum vídeo encontrado para essa busca.' : 'Você não publicou nenhum vídeo ainda' }}
        </p>
      @end
    </div>
  @end

  <style>
    .video-search { display: flex; gap: 8px; align-items: flex-start; margin-bottom: 24px; }
    .video-search .field { flex: 1; }

    .video-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
      gap: 20px;
    }
    .video-grid__empty { grid-column: 1 / -1; text-align: center; color: var(--muted); padding: 48px 0; }

    .video-card { display: flex; flex-direction: column; gap: 4px; color: inherit; text-decoration: none; }
    .video-card__thumb {
      width: 100%;
      aspect-ratio: 9 / 16;
      object-fit: cover;
      border-radius: var(--r-lg);
      background: var(--line);
      transition: transform 0.15s ease;
    }
    .video-card:hover .video-card__thumb { transform: scale(1.03); }
    .video-card__title { font-weight: 560; margin-top: 6px; line-height: 1.3; }
    .video-card__author { font-size: 13px; color: var(--muted); }
  </style>
@end
