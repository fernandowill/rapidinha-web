@layouts.app({ title: 'Enviar vídeo' })
  @page({ title: 'Enviar vídeo', description: 'Vídeo de até 100 MB (mp4, webm ou mov) e uma thumbnail de até 2 MB.' })
    @form({
      action: '/videos',
      method: 'POST',
      enctype: 'multipart/form-data',
      'x-data': '{ submitting: false }',
      'x-on:submit': 'submitting = true',
    })
      @field.root({ name: 'title' })
        @!field.label({ text: 'Título' })
        @!input.control({ placeholder: 'Dê um nome para o seu vídeo', maxlength: 100 })
        @!field.error()
      @end

      @field.root({ name: 'description' })
        @!field.label({ text: 'Descrição (opcional)' })
        @!textarea.control({ placeholder: 'Conte um pouco sobre o vídeo…' })
        @!field.error()
      @end

      @field.root({ name: 'video' })
        @!field.label({ text: 'Vídeo' })
        @!input.control({
          type: 'file',
          accept: 'video/mp4,video/webm,video/quicktime',
          'x-on:change': "if ($event.target.files[0]?.size > 100 * 1024 * 1024) { alert('O vídeo passa de 100 MB. Escolha um arquivo menor.'); $event.target.value = '' }",
        })
        @!field.error()
      @end

      @field.root({ name: 'thumbnail' })
        @!field.label({ text: 'Thumbnail' })
        @!input.control({
          type: 'file',
          accept: 'image/jpeg,image/png,image/webp',
          'x-on:change': "if ($event.target.files[0]?.size > 2 * 1024 * 1024) { alert('A imagem passa de 2 MB. Escolha um arquivo menor.'); $event.target.value = '' }",
        })
        @!field.error()
      @end

      @!button({
        text: 'Publicar',
        type: 'submit',
        block: true,
        style: 'margin-top: 4px;',
        'x-bind:disabled': 'submitting',
        'x-text': "submitting ? 'Enviando…' : 'Publicar'",
      })
    @end
  @end
@end
