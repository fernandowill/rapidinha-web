@let(pageTitle = $props.get('title'))
<!DOCTYPE html>
<html
  lang="pt-BR"
  data-theme="{{
    request.plainCookie('app_theme', {
      defaultValue: 'light',
      encoded: false,
    })
  }}"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ pageTitle ? `${pageTitle} - Rapidinha` : 'Rapidinha' }}</title>
    @vite(['resources/css/app.css', 'resources/js/app.js'])
    @stack('dumper')
  </head>
  <body>
    <header class="header header--floating">
      <div class="header__inner">
        @!logo({ size: 28 })
        <div class="header__right">
          @if(auth?.user)
            @link({ route: 'home', class: 'btn btn--primary btn--sm' })
              Vídeos
            @end
          @else
            @link({ route: 'session.create', class: 'btn btn--ghost btn--sm' })
              Entrar
            @end
            @link({ route: 'new_account.create', class: 'btn btn--primary btn--sm' })
              Criar conta
            @end
          @end
        </div>
      </div>
    </header>
    {{{ await $slots.main() }}}
    @include('partials/flash_alerts')
  </body>
</html>
