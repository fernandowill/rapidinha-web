{{--
  Top-level app navigation. Add an entry here for every new area of your
  app, and it shows up in the navigation bar with its active state handled.
--}}
@let(nav = [{ label: 'Vídeos', route: 'home', icon: 'lucide:house' }])
@if(auth?.user)
  @assign(nav = [...nav, { label: 'Meus vídeos', route: 'videos_created', icon: 'lucide:film' }])
@end
@if(auth?.user)
  @assign(nav = [...nav, { label: 'Enviar vídeo', route: 'videos_create', icon: 'lucide:upload' }])
@end
@if(auth?.user?.isAdmin)
  @assign(nav = [...nav, { label: 'Usuários', route: 'admin_users', icon: 'lucide:users' }])
@end
@if(auth?.user?.isAdmin)
  @assign(nav = [...nav, { label: 'Gerenciar vídeos', route: 'admin_videos', icon: 'lucide:clapperboard' }])
@end
@let(pageTitle = $props.get('title'))
<!DOCTYPE html>
<html
  lang="pt-BR"
  data-theme="{{
    request.plainCookie('app_theme', {
      defaultValue: 'light',
      encoded: false,
    })
  }}"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ pageTitle ? `${pageTitle} - Rapidinha` : 'Rapidinha' }}</title>
    @vite(['resources/css/app.css', 'resources/js/app.js'])
    @stack('dumper')
  </head>
  <body>
    <header class="header header--bar">
      <div class="header__inner">
        @!logo({ size: 28 })
        <div class="header__right">
          @if(auth?.user)
            <span class="header__user">{{ '@' + auth.user.username }}</span>
            @form({ route: 'session.destroy', method: 'POST' })
              <button type="submit" class="btn btn--secondary btn--sm">
                @svg('lucide:log-out', { width: 15, height: 15 })
                Sair
              </button>
            @end
          @else
            @link({ route: 'session.create', class: 'btn btn--ghost btn--sm' })
              Entrar
            @end
            @link({ route: 'new_account.create', class: 'btn btn--primary btn--sm' })
              Criar conta
            @end
          @end
        </div>
      </div>
    </header>

    <nav class="subnav">
      <div class="subnav__inner">
        @each(item in nav)
          @navLink({ route: item.route, class: 'subnav__item' })
            @if(item.icon)
              @svg(item.icon, { width: 14, height: 14 })
            @end
            {{ item.label }}
          @end
        @end
      </div>
    </nav>

    <div class="app-main">{{{ await $slots.main() }}}</div>
    @include('partials/flash_alerts')
  </body>
</html>
