@let(pageTitle = $props.get('title'))
<!DOCTYPE html>
<html
  lang="pt-BR"
  data-theme="{{
    request.plainCookie('app_theme', {
      defaultValue: 'light',
      encoded: false,
    })
  }}"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ pageTitle ? `${pageTitle} - Rapidinha` : 'Rapidinha' }}</title>
    @vite(['resources/css/app.css', 'resources/js/app.js'])
    @stack('dumper')
  </head>
  <body>
    <div class="auth">
      <div class="auth__form-col">
        @!logo({ size: 28 })
        <div class="auth__form-wrap">{{{ await $slots.main() }}}</div>
        <div style="height: 20px;"></div>
      </div>

      <aside class="auth__aside">
        <div class="auth__aside-top">
          @!themeToggle()
        </div>

        <p class="auth__quote">Vídeos curtos, do jeito que você gosta.</p>

        <div>
          <div class="pitch__t">O que dá para fazer no Rapidinha?</div>
          <p class="pitch__p">
            Assista aos vídeos da comunidade, busque pelo título e publique os seus em poucos cliques.
          </p>
          @link({ route: 'home', class: 'il pitch__a' })
            Ver vídeos →
          @end
        </div>
      </aside>
    </div>
    @include('partials/flash_alerts')
  </body>
</html>
